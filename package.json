{
  "name": "llamactl",
  "version": "0.6.0",
  "description": "A terminal UI for managing local llama.cpp (llama-server) instances.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "llamactl": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build --compile --outfile llamactl src/index.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3"
  }
}
