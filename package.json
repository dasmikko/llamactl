{
  "name": "llamactl",
  "version": "0.20.1",
  "description": "A terminal UI for managing local llama.cpp (llama-server) instances.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "llamactl": "src/index.ts"
  },
  "scripts": {
    "start": "bun --preload @opentui/solid/preload src/index.ts",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "@opentui/core": "^0.4.1",
    "@opentui/solid": "^0.4.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
